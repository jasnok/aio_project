    {
      "i": 32,
      "tag": 67,
      "level": 3,
      "size": 44,
      "text": "① 1인당 1개 작품 응모 가능합니다.\r"
    },
    {
      "i": 33,
      "tag": 68,
      "level": 3,
      "size": 8
    },
    {
      "i": 34,
      "tag": 69,
      "level": 3,
      "size": 36
    },
    {
      "i": 35,
      "tag": 66,
      "level": 2,
      "size": 24,
