  },
  "travel": {
    "transport": "streamable-http",
    "url_env": "TRAVEL_MCP_URL",
    "url_default": "http://127.0.0.1:8010/mcp"
  },
  "booking": {
    "transport": "streamable-http",
    "url_env": "BOOKING_MCP_URL",
